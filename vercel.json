{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/services", "destination": "/en/services" },
    { "source": "/services/(.*)", "destination": "/en/services/$1" },
    { "source": "/blog", "destination": "/en/blog" },
    { "source": "/blog/(.*)", "destination": "/en/blog/$1" },
    { "source": "/work", "destination": "/en/work" },
    { "source": "/work/(.*)", "destination": "/en/work/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}